# Configuración de base de datos MySQL
# Reemplaza 'tu_usuario' y 'tu_password' con tus credenciales de MySQL (por ejemplo: root y tu clave)
DATABASE_URL=mysql+pymysql://root:tu_password@localhost:3306/solident_db

# Clave secreta para JWT
SECRET_KEY=soident-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
