# ============================================================
# Variables OBLIGATORIAS (la app no arranca sin ellas)
# ============================================================

# Cadena de conexión a PostgreSQL
# Ejemplo: postgresql+psycopg2://usuario:password@localhost:5432/bd_solident
DATABASE_URL=postgresql+psycopg2://postgres:tu_password@localhost:5432/bd_solident

# Clave secreta para firmar tokens JWT (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# ============================================================
# Variables opcionales (tienen valores por defecto seguros)
# ============================================================

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos por CORS (separados por coma, sin espacios)
# En producción: https://herramientas-desarrollo-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
